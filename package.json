{
  "name": "gsm-vedomosti-win7",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Расчётные ведомости ГСМ — Windows 7 desktop, EP-inspired interface, optimized for legacy PCs",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "dist:win7": "npm run dist:win7:x86",
    "dist:win7:x86": "npm run build && electron-builder --win portable --ia32",
    "dist:win7:x64": "npm run build && electron-builder --win portable --x64",
    "dist:dir": "npm run build && electron-builder --win dir --ia32",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "vite": "5.4.21",
    "wait-on": "8.0.1"
  },
  "build": {
    "appId": "ru.gsm.vedomosti.win7",
    "productName": "ГСМ Ведомости",
    "artifactName": "GSM-Vedomosti-${version}-Win7-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "GSM-Vedomosti-${version}-portable-Win7-${arch}.${ext}"
    }
  }
}
