{
  "name": "shdk-personnel-app",
  "version": "0.7.0",
  "private": true,
  "description": "Локальная система учета личного состава, строевой и отчетов на базе SQLite",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 file:dist-electron/main/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "inspect:shdk": "tsx scripts/inspect-shdk.ts",
    "start": "electron .",
    "inspect:stroevaya": "tsx scripts/inspect-stroevaya.ts",
    "dist:win7:x86": "npm run build && electron-builder --win portable --ia32",
    "dist:win": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "exceljs": "^4.4.0",
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "22.3.27",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5",
    "wait-on": "^8.0.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron-builder": "23.6.0",
    "@types/sql.js": "1.4.11"
  },
  "build": {
    "appId": "ru.kurasava.shdk.personnel",
    "productName": "Личный состав",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "node_modules/**/*", "package.json"],
    "win": {
      "target": [{ "target": "portable", "arch": ["ia32"] }],
      "artifactName": "SHDK-Personnel-${version}-Win7-x86.${ext}"
    },
    "npmRebuild": false
  }
}
